<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reserva por E-mail | Sistema de Reservas</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #fef8e7;
            color: #5c4c3a;
            line-height: 1.6;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23e67e22' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        header {
            background: linear-gradient(135deg, #8b4513, #d2691e, #a0522d);
            color: #fff8e1;
            padding: 2rem 0;
            text-align: center;
            border-bottom: 8px solid #e67e22;
            box-shadow: 0 8px 20px rgba(139, 69, 19, 0.2);
            position: relative;
            overflow: hidden;
        }
        
        /* Folhas caindo no cabeçalho */
        .leaf {
            position: absolute;
            width: 25px;
            height: 25px;
            background-color: #e67e22;
            border-radius: 50% 0 50% 0;
            opacity: 0.7;
            animation: falling linear infinite;
        }
        
        .leaf:nth-child(1) {
            top: -30px;
            left: 10%;
            animation-duration: 10s;
            animation-delay: 0s;
            background-color: #d2691e;
        }
        
        .leaf:nth-child(2) {
            top: -30px;
            left: 30%;
            animation-duration: 12s;
            animation-delay: 2s;
            background-color: #e67e22;
        }
        
        .leaf:nth-child(3) {
            top: -30px;
            left: 60%;
            animation-duration: 15s;
            animation-delay: 4s;
            background-color: #a0522d;
        }
        
        .leaf:nth-child(4) {
            top: -30px;
            left: 80%;
            animation-duration: 11s;
            animation-delay: 1s;
            background-color: #8b4513;
        }
        
        @keyframes falling {
            0% {
                transform: translateY(-30px) rotate(0deg);
                opacity: 0.7;
            }
            100% {
                transform: translateY(500px) rotate(360deg);
                opacity: 0;
            }
        }
        
        .logo {
            font-size: 2.8rem;
            margin-bottom: 0.5rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        .logo i {
            color: #ffa726;
            text-shadow: 0 0 10px rgba(255, 167, 38, 0.5);
        }
        
        header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: #fff8e1;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
        }
        
        header p {
            font-size: 1.2rem;
            opacity: 0.95;
            max-width: 700px;
            margin: 0 auto;
            color: #ffe0b2;
        }
        
        .main-content {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            margin: 40px 0;
        }
        
        .reservation-form {
            flex: 1;
            min-width: 300px;
            background-color: #fff8e1;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 25px rgba(139, 69, 19, 0.15);
            border: 1px solid #e0c9a6;
        }
        
        .form-title {
            color: #8b4513;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #e67e22;
            font-size: 1.8rem;
            position: relative;
        }
        
        .form-title:after {
            content: "🍂";
            position: absolute;
            right: 0;
            top: 0;
            font-size: 1.5rem;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #5c4c3a;
        }
        
        .form-control {
            width: 100%;
            padding: 14px 15px;
            border: 2px solid #d7ccc8;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s;
            background-color: #fffef9;
            color: #5c4c3a;
        }
        
        .form-control:focus {
            border-color: #e67e22;
            outline: none;
            box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.2);
        }
        
        .form-row {
            display: flex;
            gap: 15px;
        }
        
        .form-row .form-group {
            flex: 1;
        }
        
        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }
        
        .submit-btn {
            background: linear-gradient(to right, #d35400, #e67e22, #f39c12);
            color: #fff8e1;
            border: none;
            padding: 16px 30px;
            font-size: 1.1rem;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            font-weight: 600;
            transition: all 0.3s;
            margin-top: 10px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(211, 84, 0, 0.3);
        }
        
        .submit-btn:hover {
            background: linear-gradient(to right, #a84300, #d35400, #e67e22);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(211, 84, 0, 0.4);
        }
        
        .submit-btn:active {
            transform: translateY(0);
        }
        
        .info-sidebar {
            flex: 1;
            min-width: 300px;
            background-color: #fff8e1;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 25px rgba(139, 69, 19, 0.15);
            border: 1px solid #e0c9a6;
        }
        
        .info-title {
            color: #8b4513;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #e67e22;
            font-size: 1.8rem;
            position: relative;
        }
        
        .info-title:after {
            content: "🍁";
            position: absolute;
            right: 0;
            top: 0;
            font-size: 1.5rem;
        }
        
        .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 25px;
        }
        
        .info-icon {
            background: linear-gradient(135deg, #e67e22, #d35400);
            color: #fff8e1;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            flex-shrink: 0;
            box-shadow: 0 4px 8px rgba(211, 84, 0, 0.2);
        }
        
        .info-text h3 {
            color: #8b4513;
            margin-bottom: 5px;
        }
        
        .info-text p {
            color: #7d6b5a;
        }
        
        .benefits {
            margin-top: 30px;
        }
        
        .benefit-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 6px;
            background-color: rgba(255, 167, 38, 0.1);
            transition: transform 0.2s;
        }
        
        .benefit-item:hover {
            transform: translateX(5px);
            background-color: rgba(255, 167, 38, 0.15);
        }
        
        .benefit-item i {
            color: #e67e22;
            margin-right: 10px;
            font-size: 1.3rem;
        }
        
        footer {
            background: linear-gradient(135deg, #8b4513, #5d4037);
            color: #ffe0b2;
            text-align: center;
            padding: 30px 0;
            margin-top: 40px;
            border-top: 5px solid #e67e22;
        }
        
        .contact-info {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 25px;
            margin-bottom: 20px;
        }
        
        .contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 15px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            transition: all 0.3s;
        }
        
        .contact-item:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }
        
        .contact-item i {
            color: #ffa726;
        }
        
        .copyright {
            opacity: 0.9;
            font-size: 0.95rem;
            margin-top: 15px;
            color: #ffcc80;
        }
        
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 18px 25px;
            border-radius: 8px;
            color: white;
            font-weight: 600;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
            display: none;
            z-index: 1000;
            animation: slideIn 0.3s ease-out;
            border-left: 5px solid #fff;
        }
        
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        .success {
            background: linear-gradient(to right, #27ae60, #2ecc71);
        }
        
        .error {
            background: linear-gradient(to right, #c0392b, #e74c3c);
        }
        
        .seasonal-decoration {
            text-align: center;
            margin: 20px 0;
            font-size: 1.5rem;
            color: #e67e22;
            opacity: 0.8;
        }
        .nav-btn {
                background-color: #CC5500;
                color: #fff9f2;
                padding: 10px 22px;
                border-radius: 20px;
                font-size: 17px;
                font-weight: 600;
                border: none;
                cursor: pointer;
                transition: 0.25s;
                box-shadow: 0 3px 6px rgba(90, 40, 10, 0.24);
                position: absolute;
                top: 20px;
                left: 20px;
}

        .nav-btn:hover {
                background-color: #c47a39;
                box-shadow: 0 4px 10px rgba(90, 40, 10, 0.35);
                transform: translateY(-2px);
}

        .nav-btn:active {
                transform: translateY(1px);
                box-shadow: 0 1px 4px rgba(90, 40, 10, 0.2);
}
    </style>
</head>
<body>
    
    <header>
<button class="nav-btn" onclick="window.location.href='/'">=</button>

        <!-- Folhas caindo (efeito outono) -->
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        <div class="leaf"></div>
        
        <div class="container">
            <div class="logo">
                <i class="fas fa-calendar-check"></i>
            </div>
            <h1>Reserva por E-mail</h1>
            <p>Faça sua reserva de forma rápida e fácil. Envie sua solicitação por e-mail e receba a confirmação em até 24 horas.</p>
        </div>
    </header>
    
    <div class="container">
        <div class="seasonal-decoration">
            🍂 🍁 Reserve seu momento especial neste outono 🍁 🍂
        </div>
        
        <div class="main-content">
            <div class="reservation-form">
                <h2 class="form-title">Solicitar Reserva</h2>
                <form id="reservationForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Nome Completo *</label>
                            <input type="text" id="name" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="phone">Telefone *</label>
                            <input type="tel" id="phone" class="form-control" required>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="email">E-mail *</label>
                        <input type="email" id="email" class="form-control" required>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="date">Data da Reserva *</label>
                            <input type="date" id="date" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="time">Horário *</label>
                            <input type="time" id="time" class="form-control" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="guests">Número de Pessoas *</label>
                            <select id="guests" class="form-control" required>
                                <option value="">Selecione</option>
                                <option value="1">1 pessoa</option>
                                <option value="2">2 pessoas</option>
                                <option value="3">3 pessoas</option>
                                <option value="4">4 pessoas</option>
                                <option value="5">5 pessoas</option>
                                <option value="6">6 pessoas</option>
                                <option value="7">7 ou mais pessoas</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="service">Tipo de Serviço *</label>
                            <select id="service" class="form-control" required>
                                <option value="">Selecione</option>
                                <option value="restaurante">Restaurante</option>
                                <option value="hotel">Hotel</option>
                                <option value="spa">Spa & Bem-estar</option>
                                <option value="evento">Evento Especial</option>
                                <option value="outro">Outro</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="message">Mensagem Adicional</label>
                        <textarea id="message" class="form-control" placeholder="Informações adicionais, observações ou requisitos especiais..."></textarea>
                    </div>
                    
                    <button type="submit" class="submit-btn">
                        <i class="fas fa-paper-plane"></i> Enviar Solicitação por E-mail
                    </button>
                </form>
            </div>
            
    
    <div id="notification" class="notification"></div>
    
    <script>
        document.getElementById('reservationForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Coletar dados do formulário
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const phone = document.getElementById('phone').value;
            const date = document.getElementById('date').value;
            const time = document.getElementById('time').value;
            const guests = document.getElementById('guests').value;
            const service = document.getElementById('service').value;
            const message = document.getElementById('message').value;
            
            // Validação básica
            if (!name || !email || !phone || !date || !time || !guests || !service) {
                showNotification('Por favor, preencha todos os campos obrigatórios.', 'error');
                return;
            }
            
            // Simular envio por e-mail
            showNotification('Solicitação de reserva enviada com sucesso! Você receberá uma confirmação por e-mail em breve.', 'success');
            
            // Resetar formulário
            setTimeout(() => {
                document.getElementById('reservationForm').reset();
                // Configurar data mínima como hoje novamente
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('date').min = today;
                
                // Preencher novamente com dados de demonstração
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                const tomorrowStr = tomorrow.toISOString().split('T')[0];
                document.getElementById('date').value = tomorrowStr;
                document.getElementById('time').value = '19:30';
            }, 2000);
            
            // Em um ambiente real, aqui você enviaria os dados para um servidor
            // que enviaria um e-mail de verdade
            console.log('Dados da reserva para envio por e-mail:', {
                name, email, phone, date, time, guests, service, message
            });
        });
        
        // Configurar data mínima como hoje
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('date').min = today;
        
        // Função para mostrar notificação
        function showNotification(message, type) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type}`;
            notification.style.display = 'block';
            
            setTimeout(() => {
                notification.style.display = 'none';
            }, 5000);
        }
        
        // Exemplo de dados preenchidos para demonstração
        document.addEventListener('DOMContentLoaded', function() {
            // Para demonstração, preencher alguns campos com dados de exemplo
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tomorrowStr = tomorrow.toISOString().split('T')[0];
            
            document.getElementById('date').value = tomorrowStr;
            document.getElementById('time').value = '19:30';
        });
    </script>
</body>
</html>
