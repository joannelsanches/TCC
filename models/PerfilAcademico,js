import conexao from '../config/conexao.js'

const PerfilAcademico = new conexao.Schema({
    aluno: {
        type: conexao.Schema.Types.ObjectId,
        ref: 'Aluno',
        required: true
    },
    curso: {
        type: String,
        enum: ["Técnico em Informatica", "Técnico em Agropecuária", "Técnico em Meio Ambiente"],
        required: true
    },
    semestre: {
        type: Number,
        enum: [1, 2, 3, 4, 5, 6, 7, 8],
        required: true
    }, 
    competencias: {
        type: String,
        required: true
    }
});

export default conexao.model('PerfilAcademico', PerfilAcademico)